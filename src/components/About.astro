---
interface Props {
  title?: string;
  statement?: string;
}

const {
  title = 'About',
  statement = 'Flutter Mobile Application Developer with 5+ years of experience delivering cross platform apps across agriculture, ecommerce, telemedicine, fintech, social, operations, and service marketplaces.',
} = Astro.props;
---

<section class="about-section" id="about">
  <div class="about-container">
    <!-- Left Column: Title -->
    <div class="about-title-col">
      <h2 class="about-title">{title}</h2>
    </div>

    <!-- Right Column: Editorial Statement & Columns -->
    <div class="about-content-col">
      <p class="about-statement">
        {statement}
      </p>

      <div class="about-columns">
        <div class="col-item">
          <span class="col-label">PROFILE</span>
          <p class="col-text">
            Skilled in offline first solutions, performance optimization, and creating intuitive user experiences. Adaptable, collaborative, and passionate about building impactful digital products. I stay current with tools and frameworks and adapt quickly to evolving industry trends.
          </p>
        </div>

        <div class="col-item">
          <span class="col-label">EDUCATION & LOCATION</span>
          <p class="col-text">
            BSc Computer Science, Joseph Ayo Babalola University (Sep 2019 to Aug 2023, Ikeji Arakeji, Osun State). Languages: English, Yoruba, Hausa. Based in Abuja, Nigeria.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    position: relative;
    width: 100%;
    padding: clamp(4.5rem, 8vh, 8rem) clamp(1.25rem, 4vw, 3.5rem) clamp(5rem, 9vh, 9rem);
    box-sizing: border-box;
    background-color: #f7f6f4;
    color: #141414;
    font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', Roboto, sans-serif;
    user-select: none;
  }

  .about-container {
    width: 100%;
    max-width: 1360px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
  }

  .about-title-col {
    display: flex;
    flex-direction: column;
  }

  .about-title {
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 0.95;
    color: #121212;
  }

  .about-content-col {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vh, 4rem);
  }

  .about-statement {
    margin: 0;
    font-size: clamp(1.2rem, 2.4vw, 1.85rem);
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: -0.02em;
    color: #595959;
    max-width: 820px;
  }

  .about-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    max-width: 820px;
  }

  .col-item {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .col-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8c8c8c;
  }

  .col-text {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.65;
    color: #404040;
  }

  @media (max-width: 960px) {
    .about-container {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .about-columns {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }

  @media (max-width: 640px) {
    .about-section {
      padding: 4rem 1.25rem 5rem;
    }

    .about-title {
      font-size: 2.2rem;
    }

    .about-statement {
      font-size: 1.15rem;
      line-height: 1.5;
    }
  }
</style>
