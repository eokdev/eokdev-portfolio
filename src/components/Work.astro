---
import { projectsData } from '../data/projects';

interface Props {
  projects?: typeof projectsData;
}

const { projects = projectsData } = Astro.props;
---

<section class="work-section" id="work" data-work-section>
  <!-- Top Minimalist Section Header -->
  <div class="work-header">
    <div class="header-left">
      <span class="section-label">SELECTED WORKS</span>
      <span class="project-count">({projects.length.toString().padStart(2, '0')})</span>
    </div>
    <div class="header-right">
      <span class="nav-hint" data-active-counter>01 / {projects.length.toString().padStart(2, '0')}</span>
    </div>
  </div>

  <!-- Main 3-Column Interactive Layout -->
  <div class="work-container">
    <!-- Left: Minimalist Project List (Horizontal scrollable on mobile, column on desktop) -->
    <div class="projects-list-col">
      <ul class="projects-list" role="tablist">
        {projects.map((item, idx) => (
          <li class="project-item">
            <button
              type="button"
              class:list={['project-nav-btn', { active: idx === 0 }]}
              data-project-index={idx}
              role="tab"
              aria-selected={idx === 0}
            >
              <span class="item-index">{item.index}</span>
              <span class="item-name">{item.name}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>

    <div class="showcase-col">
      <div class="showcase-frame" data-showcase-frame>
        {projects.map((item, idx) => (
          <div
            class:list={['shot-stack', { active: idx === 0 }]}
            data-stack-index={idx}
          >
            {item.gallery.map((src, shotIdx) => (
              <figure class="shot-card" data-shot-index={shotIdx}>
                <img
                  src={src}
                  alt={`${item.name} screenshot ${shotIdx + 1}`}
                  class="shot-img"
                  loading={idx === 0 && shotIdx === 0 ? 'eager' : 'lazy'}
                />
              </figure>
            ))}
            <div class="shot-meta">
              <span data-shot-counter>
                01 / {item.gallery.length.toString().padStart(2, '0')}
              </span>
              {item.gallery.length > 1 && (
                <span class="shot-hint">Swipe for more</span>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Right: Dynamic Details & Links -->
    <div class="details-col">
      {projects.map((item, idx) => (
        <div class:list={['project-detail-panel', { active: idx === 0 }]} data-detail-index={idx}>
          <div class="detail-header">
            <span class="detail-category">{item.category}</span>
            <span class="detail-year">{item.year}</span>
          </div>

          <h3 class="detail-title">{item.name}</h3>

          <p class="detail-blurb">{item.blurb}</p>

          <div class="detail-tags">
            {item.tags.map((tag) => (
              <span class="tag-pill">{tag}</span>
            ))}
          </div>

          <div class="detail-links">
            {item.iosUrl && (
              <a href={item.iosUrl} target="_blank" rel="noopener noreferrer" class="action-link">
                App Store
              </a>
            )}
            {item.androidUrl && (
              <a href={item.androidUrl} target="_blank" rel="noopener noreferrer" class="action-link">
                Google Play
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  function initWorkSection() {
    const section = document.querySelector<HTMLElement>('[data-work-section]');
    if (!section || section.dataset.workReady === '1') return;
    section.dataset.workReady = '1';

    const navButtons = section.querySelectorAll<HTMLButtonElement>('[data-project-index]');
    const stacks = section.querySelectorAll<HTMLElement>('[data-stack-index]');
    const details = section.querySelectorAll<HTMLElement>('[data-detail-index]');
    const counter = section.querySelector<HTMLElement>('[data-active-counter]');
    const total = navButtons.length;
    const shotIndexByProject = Array.from(stacks, () => 0);

    let currentIndex = 0;

    function pad(n: number) {
      return n.toString().padStart(2, '0');
    }

    function renderStack(projectIndex: number) {
      const stack = stacks[projectIndex];
      if (!stack) return;
      const cards = stack.querySelectorAll<HTMLElement>('[data-shot-index]');
      const shotCounter = stack.querySelector<HTMLElement>('[data-shot-counter]');
      const current = shotIndexByProject[projectIndex] ?? 0;
      const count = cards.length;

      cards.forEach((card, shotIdx) => {
        const rel = (shotIdx - current + count) % count;
        card.classList.toggle('is-front', rel === 0);
        card.classList.toggle('is-next', rel === 1);
        card.classList.toggle('is-deep', rel === 2);
        card.classList.toggle('is-hidden', rel > 2);
        card.style.zIndex = String(count - rel);
      });

      if (shotCounter) {
        shotCounter.textContent = `${pad(current + 1)} / ${pad(count)}`;
      }
    }

    function stepShot(dir: number) {
      const stack = stacks[currentIndex];
      if (!stack) return;
      const count = stack.querySelectorAll('[data-shot-index]').length;
      if (count < 2) return;
      shotIndexByProject[currentIndex] =
        (shotIndexByProject[currentIndex] + dir + count) % count;
      renderStack(currentIndex);
    }

    stacks.forEach((_, idx) => renderStack(idx));

    function goToProject(newIndex: number) {
      if (newIndex === currentIndex || newIndex < 0 || newIndex >= total) return;
      currentIndex = newIndex;

      navButtons.forEach((btn, idx) => {
        const isActive = idx === currentIndex;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-selected', isActive.toString());
        if (isActive) {
          btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      });

      if (counter) {
        counter.textContent = `${pad(currentIndex + 1)} / ${pad(total)}`;
      }

      stacks.forEach((stack, idx) => {
        const on = idx === currentIndex;
        gsap.killTweensOf(stack);
        gsap.set(stack, { clearProps: 'opacity,transform,y' });
        stack.classList.toggle('active', on);
      });
      renderStack(currentIndex);

      const nextStack = stacks[currentIndex];
      if (nextStack) {
        gsap.fromTo(
          nextStack,
          { y: 14 },
          { y: 0, duration: 0.32, ease: 'power2.out', clearProps: 'transform' }
        );
      }

      details.forEach((panel, idx) => {
        gsap.killTweensOf(panel);
        gsap.set(panel, { clearProps: 'opacity,transform,y' });
        panel.classList.toggle('active', idx === currentIndex);
      });
    }

    // Button click listeners
    navButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetIndex = parseInt(btn.dataset.projectIndex || '0', 10);
        goToProject(targetIndex);
      });

      btn.addEventListener('mouseenter', () => {
        if (window.innerWidth >= 1024) {
          const targetIndex = parseInt(btn.dataset.projectIndex || '0', 10);
          goToProject(targetIndex);
        }
      });
    });

    const frame = section.querySelector<HTMLElement>('[data-showcase-frame]');
    if (frame) {
      let pointerStartX = 0;
      let pointerStartY = 0;
      let pointerActive = false;

      frame.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;
        pointerActive = true;
        pointerStartX = e.clientX;
        pointerStartY = e.clientY;
        frame.setPointerCapture(e.pointerId);
      });

      frame.addEventListener('pointerup', (e) => {
        if (!pointerActive) return;
        pointerActive = false;
        if (frame.hasPointerCapture(e.pointerId)) {
          frame.releasePointerCapture(e.pointerId);
        }
        const deltaX = e.clientX - pointerStartX;
        const deltaY = e.clientY - pointerStartY;
        if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) > 36) {
          stepShot(deltaX < 0 ? 1 : -1);
          return;
        }
        if (Math.abs(deltaX) < 8 && Math.abs(deltaY) < 8) {
          stepShot(1);
        }
      });

      frame.addEventListener('pointercancel', () => {
        pointerActive = false;
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWorkSection);
  } else {
    initWorkSection();
  }
  document.addEventListener('astro:page-load', initWorkSection);
</script>

<style>
  .work-section {
    position: relative;
    width: 100%;
    max-width: 100vw;
    min-height: 100vh;
    padding: clamp(3rem, 6vh, 5rem) clamp(1.25rem, 4vw, 3.5rem);
    box-sizing: border-box;
    background-color: #ffffff;
    color: #121212;
    font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', Roboto, sans-serif;
    user-select: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow-x: hidden;
  }

  /* Top Minimal Header */
  .work-header {
    width: 100%;
    max-width: 1360px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 2rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #737373;
  }

  .header-left {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .section-label {
    color: #171717;
    font-weight: 600;
  }

  .project-count {
    color: #a3a3a3;
  }

  .nav-hint {
    color: #737373;
    font-variant-numeric: tabular-nums;
  }

  /* 3-Column Container */
  .work-container {
    display: grid;
    grid-template-columns: 240px minmax(280px, 1fr) 300px;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
    width: 100%;
    max-width: 1360px;
    margin: auto auto;
    min-height: clamp(560px, 72vh, 740px);
  }

  /* Left Column: Nav List */
  .projects-list-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
  }

  .projects-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .project-item {
    margin: 0;
    padding: 0;
    flex-shrink: 0;
  }

  .project-nav-btn {
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    border: none;
    outline: none;
    padding: 0.35rem 0;
    margin: 0;
    font-family: inherit;
    font-size: 0.92rem;
    font-weight: 500;
    color: #a3a3a3;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    text-align: left;
    transition: color 0.25s ease, transform 0.25s ease;
    width: 100%;
    -webkit-tap-highlight-color: transparent;
  }

  .project-nav-btn:focus,
  .project-nav-btn:focus-visible {
    outline: none;
    box-shadow: none;
  }

  .item-index {
    font-size: 0.72rem;
    color: #d4d4d4;
    font-variant-numeric: tabular-nums;
    transition: color 0.25s ease;
  }

  .item-name {
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .project-nav-btn:hover {
    color: #404040;
    transform: translateX(4px);
  }

  .project-nav-btn.active {
    color: #000000;
    font-weight: 600;
    transform: translateX(8px);
  }

  .project-nav-btn.active .item-index {
    color: #171717;
  }

  /* Center Column: Animated Visual Stage */
  .showcase-col {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .showcase-frame {
    position: relative;
    width: clamp(220px, 22vw, 300px);
    height: clamp(460px, 62vh, 640px);
    overflow: visible;
    cursor: grab;
    background-color: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: pan-y;
  }

  .showcase-frame:active {
    cursor: grabbing;
  }

  .shot-stack {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    isolation: isolate;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .shot-stack.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    z-index: 2;
  }

  .shot-card {
    position: absolute;
    width: 78%;
    height: auto;
    margin: 0;
    border-radius: 18px;
    overflow: hidden;
    background: transparent;
    border: none;
    box-shadow: 0 14px 32px rgba(18, 18, 18, 0.16);
    transform-origin: center center;
    transition:
      transform 0.42s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.32s ease;
    pointer-events: none;
  }

  .shot-card.is-front {
    transform: translate3d(-18px, 0, 0) rotate(-2deg) scale(1);
    opacity: 1;
    pointer-events: auto;
  }

  .shot-card.is-next {
    transform: translate3d(28px, 14px, 0) rotate(6deg) scale(0.92);
    opacity: 0.94;
  }

  .shot-card.is-deep {
    transform: translate3d(52px, 26px, 0) rotate(11deg) scale(0.84);
    opacity: 0.62;
  }

  .shot-card.is-hidden {
    transform: translate3d(72px, 38px, 0) rotate(14deg) scale(0.78);
    opacity: 0;
  }

  .shot-img {
    width: 100%;
    height: auto;
    display: block;
    background: transparent;
    user-select: none;
    -webkit-user-drag: none;
  }

  .shot-meta {
    position: absolute;
    bottom: -2px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #737373;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    z-index: 20;
    pointer-events: none;
  }

  .shot-hint {
    color: #a3a3a3;
  }

  /* Right Column: Project Details Panel */
  .details-col {
    position: relative;
    min-height: 280px;
    display: flex;
    align-items: center;
  }

  .project-detail-panel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.95rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .project-detail-panel.active {
    opacity: 1;
    pointer-events: auto;
    position: relative;
  }

  .detail-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #737373;
  }

  .detail-title {
    margin: 0;
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #121212;
    line-height: 1.15;
  }

  .detail-blurb {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.6;
    color: #525252;
  }

  .detail-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag-pill {
    font-size: 0.68rem;
    font-weight: 500;
    color: #737373;
    background-color: #f5f5f5;
    padding: 0.22rem 0.6rem;
    border-radius: 9999px;
  }

  .detail-links {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    margin-top: 0.25rem;
  }

  .action-link {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #171717;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.2s ease;
  }

  .action-link:hover {
    color: #737373;
  }

  @media (max-width: 1080px) {
    .work-container {
      grid-template-columns: 1fr 1fr;
      gap: 3rem 2rem;
    }

    .projects-list-col {
      grid-column: span 2;
      width: 100%;
    }

    .projects-list {
      flex-direction: row;
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      padding: 0.25rem 0 0.5rem;
      gap: 0.65rem;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .projects-list::-webkit-scrollbar {
      display: none;
    }

    .project-nav-btn {
      padding: 0.45rem 1rem;
      background-color: #f2f1ee;
      border-radius: 9999px;
      font-size: 0.82rem;
      white-space: nowrap;
      transform: none !important;
      border: none;
      outline: none;
    }

    .project-nav-btn.active {
      background-color: #171717;
      color: #ffffff;
      transform: none !important;
      border: none;
      outline: none;
    }

    .project-nav-btn.active .item-index {
      color: #a3a3a3;
    }

    .showcase-frame {
      width: clamp(220px, 32vw, 280px);
      height: clamp(440px, 58vh, 600px);
    }

    .showcase-col {
      order: 2;
    }

    .details-col {
      order: 3;
    }
  }

  @media (max-width: 768px) {
    .work-section {
      padding: 3rem 1.25rem 3.5rem;
    }

    .work-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2.25rem;
      min-height: auto;
    }

    .showcase-frame {
      width: clamp(200px, 62vw, 260px);
      height: clamp(400px, 54vh, 540px);
    }

    .details-col {
      min-height: auto;
      width: 100%;
    }
  }
</style>
