---
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  name?: string;
  role?: string;
  welcomeText?: string;
  description?: string;
  bannerImage?: string;
  navLinks?: NavLink[];
}

const {
  name = "Emmanuel Olorunshola",
  role = "Flutter Engineer",
  welcomeText = "Welcome:",
  description = "Flutter engineer with 5+ years shipping production Android and iOS apps. The work covers marketplaces, ecommerce, fintech, telemedicine, social, and operations. If it belongs on a phone, I will build it.",
  bannerImage = "/images/hero-banner.jpg",
  navLinks = [
    { label: "Work", href: "#work" },
    { label: "Experience", href: "#experience" },
    { label: "About", href: "#about" },
    { label: "Contact", href: "#contact" },
  ],
} = Astro.props;
---

<header class="hero-section" id="hero">
  <!-- Top White Editorial Area -->
  <div class="hero-canvas">
    <!-- Top Editorial Header Bar -->
    <div class="hero-topbar" data-hero-topbar>
      <a href="#hero" class="brand-name">
        <img src="/images/logo-dark.svg" alt="EOK Logo" class="brand-logo" />
        <span>{name}</span>
      </a>
      <nav class="top-nav" aria-label="Quick links">
        {
          navLinks.map((link, idx) => (
            <span class="nav-entry">
              <a href={link.href} class="nav-text-link">
                {link.label}
              </a>
              {idx < navLinks.length - 1 && <span class="nav-comma">, </span>}
            </span>
          ))
        }
      </nav>
    </div>

    <!-- Main Editorial Content Area -->
    <div class="hero-body">
      <!-- Bottom-Left Label -->
      <div class="welcome-col" data-hero-welcome>
        <span class="welcome-label">{welcomeText}</span>
      </div>

      <!-- Right-Aligned Typographic Headline & Description -->
      <div class="headline-col" data-hero-headline>
        <h1 class="display-title">
          <span class="title-line">{name}</span>
          <span class="title-line role-line">{role}</span>
        </h1>
        <p class="display-description">
          {description}
        </p>
      </div>
    </div>
  </div>

  <!-- Full-Width Architectural / Structural Image Banner -->
  <div class="hero-banner-container" data-hero-banner>
    <img
      src={bannerImage}
      alt="Emmanuel Olorunshola - Architectural Minimalist Space"
      class="hero-banner-img"
      loading="eager"
      decoding="async"
    />
  </div>
</header>

<script>
  import gsap from "gsap";

  function initHeroAnimation() {
    const topbar = document.querySelector<HTMLElement>("[data-hero-topbar]");
    const welcome = document.querySelector<HTMLElement>("[data-hero-welcome]");
    const titleLines = document.querySelectorAll<HTMLElement>(
      "[data-hero-headline] .title-line",
    );
    const description = document.querySelector<HTMLElement>(
      "[data-hero-headline] .display-description",
    );
    const banner = document.querySelector<HTMLElement>("[data-hero-banner]");

    if (!titleLines.length) return;

    const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

    // Topbar & Welcome subtle entrance
    if (topbar) {
      tl.fromTo(
        topbar,
        { opacity: 0, y: -15 },
        { opacity: 1, y: 0, duration: 0.8, clearProps: "transform" },
      );
    }

    // Title entrance
    tl.fromTo(
      titleLines,
      { opacity: 0, y: 40 },
      {
        opacity: 1,
        y: 0,
        duration: 1.0,
        stagger: 0.12,
        clearProps: "transform",
      },
      "-=0.5",
    );

    // Description entrance
    if (description) {
      tl.fromTo(
        description,
        { opacity: 0, y: 24 },
        { opacity: 1, y: 0, duration: 0.9, clearProps: "transform" },
        "-=0.6",
      );
    }

    // Welcome label entrance
    if (welcome) {
      tl.fromTo(
        welcome,
        { opacity: 0, y: 15 },
        { opacity: 1, y: 0, duration: 0.8, clearProps: "transform" },
        "-=0.7",
      );
    }

    // Banner image entrance
    if (banner) {
      tl.fromTo(
        banner,
        { opacity: 0, scale: 0.98 },
        {
          opacity: 1,
          scale: 1,
          duration: 1.2,
          ease: "power2.out",
          clearProps: "transform",
        },
        "-=0.8",
      );
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeroAnimation);
  } else {
    initHeroAnimation();
  }
  document.addEventListener("astro:page-load", initHeroAnimation);
</script>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    min-width: 100%;
    background-color: #ffffff;
    color: #111111;
    font-family:
      -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, sans-serif;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Upper Canvas Area */
  .hero-canvas {
    width: 100%;
    max-width: 100%;
    padding: clamp(1.5rem, 3vw, 2.75rem) clamp(1.25rem, 4vw, 3.5rem) clamp(2rem, 4.5vw, 3.75rem);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    min-height: auto;
    justify-content: space-between;
  }

  /* Top Bar */
  .hero-topbar {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: clamp(0.8rem, 1vw, 0.92rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #111111;
    flex-wrap: wrap;
  }

  .brand-name {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: #111111;
    text-decoration: none;
    font-weight: 600;
    transition: opacity 0.2s ease;
    flex-shrink: 0;
  }

  .brand-logo {
    width: 20px;
    height: 20px;
    display: block;
  }

  .brand-name:hover {
    opacity: 0.7;
  }

  .top-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    font-weight: 400;
    color: #222222;
    gap: 0.15rem 0.35rem;
  }

  .nav-entry {
    display: inline-flex;
    align-items: center;
  }

  .nav-text-link {
    color: #222222;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-text-link:hover {
    color: #000000;
    text-decoration: underline;
  }

  .nav-comma {
    margin-right: 0.2rem;
    color: #888888;
  }

  /* Hero Body Layout */
  .hero-body {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(100px, 1fr) minmax(280px, 1.35fr);
    align-items: flex-end;
    gap: clamp(1.5rem, 3vw, 3rem);
    margin-top: clamp(2.5rem, 6vh, 5rem);
  }

  /* Bottom Left Label */
  .welcome-col {
    display: flex;
    align-items: flex-end;
    padding-bottom: 0.25rem;
  }

  .welcome-label {
    font-size: clamp(0.8rem, 1vw, 0.9rem);
    font-weight: 500;
    color: #111111;
    letter-spacing: -0.01em;
  }

  /* Right Headline Column */
  .headline-col {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vh, 1.75rem);
    width: 100%;
    max-width: 100%;
  }

  .display-title {
    margin: 0;
    font-size: clamp(2.1rem, 4.4vw, 4.4rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.035em;
    color: #111111;
    display: flex;
    flex-direction: column;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .title-line {
    display: block;
  }

  .display-description {
    margin: 0;
    max-width: 540px;
    font-size: clamp(0.85rem, 1.05vw, 0.98rem);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: #333333;
  }

  /* Full-Width Image Banner */
  .hero-banner-container {
    width: 100%;
    max-width: 100%;
    height: clamp(280px, 46vh, 580px);
    overflow: hidden;
    background-color: #1a1a1a;
  }

  .hero-banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
  }

  /* Responsive Breakpoints */
  @media (max-width: 960px) {
    .hero-canvas {
      padding: clamp(1.25rem, 3vw, 2rem) clamp(1rem, 3vw, 2rem) clamp(1.75rem, 4vw, 2.5rem);
    }

    .hero-body {
      grid-template-columns: 1fr;
      gap: 2rem;
      margin-top: clamp(2rem, 4vh, 3.5rem);
    }

    .welcome-col {
      order: 2;
    }

    .headline-col {
      order: 1;
    }

    .display-title {
      font-size: clamp(2.2rem, 6.5vw, 3.6rem);
    }

    .hero-banner-container {
      height: clamp(240px, 38vh, 420px);
    }
  }

  @media (max-width: 600px) {
    .hero-topbar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem;
    }

    .brand-name {
      font-size: 0.88rem;
    }

    .brand-logo {
      width: 18px;
      height: 18px;
    }

    .top-nav {
      font-size: 0.8rem;
    }

    .hero-body {
      gap: 1.5rem;
      margin-top: 2rem;
    }

    .display-title {
      font-size: clamp(1.85rem, 8.2vw, 2.5rem);
      line-height: 1.1;
    }

    .display-description {
      font-size: 0.86rem;
      line-height: 1.5;
    }

    .welcome-label {
      font-size: 0.82rem;
    }

    .hero-banner-container {
      height: clamp(200px, 32vh, 300px);
    }
  }

  @media (max-width: 380px) {
    .hero-topbar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
