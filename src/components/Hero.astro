---
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  name?: string;
  role?: string;
  welcomeText?: string;
  description?: string;
  bannerImage?: string;
  navLinks?: NavLink[];
}

const {
  name = 'Emmanuel Olorunshola',
  role = 'Flutter Engineer',
  welcomeText = 'Welcome:',
  description = 'Blending precision with scale, mobile applications are crafted to deliver seamless performance while solving critical real-world problems with enduring reliability.',
  bannerImage = '/images/hero-banner.jpg',
  navLinks = [
    { label: 'Work', href: '#work' },
    { label: 'Experience', href: '#experience' },
    { label: 'About', href: '#about' },
    { label: 'Contact', href: '#contact' },
  ],
} = Astro.props;
---

<header class="hero-section" id="hero">
  <!-- Top White Editorial Area -->
  <div class="hero-canvas">
    <!-- Top Editorial Header Bar -->
    <div class="hero-topbar" data-hero-topbar>
      <a href="#hero" class="brand-name">{name}</a>
      <nav class="top-nav" aria-label="Quick links">
        {navLinks.map((link, idx) => (
          <span class="nav-entry">
            <a href={link.href} class="nav-text-link">{link.label}</a>
            {idx < navLinks.length - 1 && <span class="nav-comma">, </span>}
          </span>
        ))}
      </nav>
    </div>

    <!-- Main Editorial Content Area -->
    <div class="hero-body">
      <!-- Bottom-Left Label -->
      <div class="welcome-col" data-hero-welcome>
        <span class="welcome-label">{welcomeText}</span>
      </div>

      <!-- Right-Aligned Typographic Headline & Description -->
      <div class="headline-col" data-hero-headline>
        <h1 class="display-title">
          <span class="title-line">{name}</span>
          <span class="title-line role-line">{role}</span>
        </h1>
        <p class="display-description">
          {description}
        </p>
      </div>
    </div>
  </div>

  <!-- Full-Width Architectural / Structural Image Banner -->
  <div class="hero-banner-container" data-hero-banner>
    <img 
      src={bannerImage} 
      alt="Emmanuel Olorunshola - Architectural Minimalist Space" 
      class="hero-banner-img"
      loading="eager"
      decoding="async"
    />
  </div>
</header>

<script>
  import gsap from 'gsap';

  function initHeroAnimation() {
    const topbar = document.querySelector<HTMLElement>('[data-hero-topbar]');
    const welcome = document.querySelector<HTMLElement>('[data-hero-welcome]');
    const titleLines = document.querySelectorAll<HTMLElement>('[data-hero-headline] .title-line');
    const description = document.querySelector<HTMLElement>('[data-hero-headline] .display-description');
    const banner = document.querySelector<HTMLElement>('[data-hero-banner]');

    if (!titleLines.length) return;

    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    // Topbar & Welcome subtle entrance
    if (topbar) {
      tl.fromTo(
        topbar,
        { opacity: 0, y: -15 },
        { opacity: 1, y: 0, duration: 0.8, clearProps: 'transform' }
      );
    }

    // Title entrance
    tl.fromTo(
      titleLines,
      { opacity: 0, y: 40 },
      { opacity: 1, y: 0, duration: 1.0, stagger: 0.12, clearProps: 'transform' },
      '-=0.5'
    );

    // Description entrance
    if (description) {
      tl.fromTo(
        description,
        { opacity: 0, y: 24 },
        { opacity: 1, y: 0, duration: 0.9, clearProps: 'transform' },
        '-=0.6'
      );
    }

    // Welcome label entrance
    if (welcome) {
      tl.fromTo(
        welcome,
        { opacity: 0, y: 15 },
        { opacity: 1, y: 0, duration: 0.8, clearProps: 'transform' },
        '-=0.7'
      );
    }

    // Banner image entrance
    if (banner) {
      tl.fromTo(
        banner,
        { opacity: 0, scale: 0.98 },
        { opacity: 1, scale: 1, duration: 1.2, ease: 'power2.out', clearProps: 'transform' },
        '-=0.8'
      );
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroAnimation);
  } else {
    initHeroAnimation();
  }
  document.addEventListener('astro:page-load', initHeroAnimation);
</script>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    min-width: 100%;
    background-color: #ffffff;
    color: #111111;
    font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', Roboto, sans-serif;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Upper Canvas Area */
  .hero-canvas {
    width: 100%;
    max-width: 100%;
    padding: clamp(1.75rem, 3.5vw, 3rem) clamp(1.5rem, 4.5vw, 4rem) clamp(2.5rem, 5vw, 4.5rem);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    min-height: clamp(380px, 48vh, 520px);
    justify-content: space-between;
  }

  /* Top Bar */
  .hero-topbar {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: clamp(0.82rem, 1.1vw, 0.95rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #111111;
  }

  .brand-name {
    color: #111111;
    text-decoration: none;
    font-weight: 600;
    transition: opacity 0.2s ease;
  }

  .brand-name:hover {
    opacity: 0.7;
  }

  .top-nav {
    display: flex;
    align-items: center;
    font-weight: 400;
    color: #222222;
  }

  .nav-entry {
    display: inline-flex;
    align-items: center;
  }

  .nav-text-link {
    color: #222222;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-text-link:hover {
    color: #000000;
    text-decoration: underline;
  }

  .nav-comma {
    margin-right: 0.35rem;
    color: #666666;
  }

  /* Hero Body Layout */
  .hero-body {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    align-items: flex-end;
    gap: 2rem;
    margin-top: clamp(3rem, 7vh, 6rem);
  }

  /* Bottom Left Label */
  .welcome-col {
    display: flex;
    align-items: flex-end;
    padding-bottom: 0.25rem;
  }

  .welcome-label {
    font-size: clamp(0.82rem, 1vw, 0.92rem);
    font-weight: 500;
    color: #111111;
    letter-spacing: -0.01em;
  }

  /* Right Headline Column */
  .headline-col {
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 2.5vh, 2rem);
  }

  .display-title {
    margin: 0;
    font-size: clamp(2.4rem, 5.2vw, 4.8rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: #111111;
    display: flex;
    flex-direction: column;
  }

  .title-line {
    display: block;
    white-space: nowrap;
  }

  .display-description {
    margin: 0;
    max-width: 520px;
    font-size: clamp(0.85rem, 1.1vw, 1rem);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: #333333;
  }

  /* Full-Width Image Banner */
  .hero-banner-container {
    width: 100%;
    max-width: 100%;
    height: clamp(340px, 48vh, 620px);
    overflow: hidden;
    background-color: #1a1a1a;
  }

  .hero-banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
  }

  /* Responsive Breakpoints */
  @media (max-width: 900px) {
    .hero-canvas {
      padding: 1.75rem 1.5rem 2rem;
      min-height: auto;
    }

    .hero-body {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      margin-top: 3rem;
    }

    .welcome-col {
      order: 2;
    }

    .headline-col {
      order: 1;
    }

    .display-title {
      font-size: clamp(2rem, 8vw, 3.4rem);
    }

    .title-line {
      white-space: normal;
    }

    .hero-banner-container {
      height: clamp(260px, 40vh, 420px);
    }
  }

  @media (max-width: 540px) {
    .hero-topbar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .display-title {
      font-size: clamp(1.85rem, 9vw, 2.6rem);
      line-height: 1.1;
    }

    .display-description {
      font-size: 0.88rem;
    }
  }
</style>
