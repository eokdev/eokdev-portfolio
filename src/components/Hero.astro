---
interface NavItem {
  label: string;
  href: string;
  active?: boolean;
}

type ColorTheme = 'sage' | 'petrol' | 'sandstone' | 'charcoal' | 'plum';

interface Props {
  titleLine1?: string;
  titleLine2?: string;
  subtitle?: string;
  lastUpdated?: string;
  location?: string;
  navItems?: NavItem[];
  theme?: ColorTheme;
  customBackground?: string;
}

const {
  titleLine1 = 'EMMANUEL',
  titleLine2 = 'OLORUNSHOLA',
  subtitle = 'BUILDING PRODUCTION FLUTTER & MOBILE EXPERIENCES DESIGNED FOR REAL USERS AND HIGH-PERFORMANCE SCALE.',
  lastUpdated = 'September, 2026',
  location = 'ABUJA   28°C   2:40 PM',
  theme = 'sage',
  customBackground,
  navItems = [
    { label: 'Home', href: '#', active: true },
    { label: 'Work', href: '#work' },
    { label: 'Experience', href: '#experience' },
    { label: 'Capabilities', href: '#capabilities' },
    { label: 'About', href: '#about' },
    { label: 'Contact', href: '#contact' },
  ],
} = Astro.props;

const gradients: Record<ColorTheme, string> = {
  sage: 'linear-gradient(180deg, #2d3b37 0%, #465953 38%, #5d6f68 72%, #3f4e48 100%)',
  petrol: 'linear-gradient(180deg, #16242d 0%, #263844 40%, #364d5c 75%, #1f2e37 100%)',
  sandstone: 'linear-gradient(180deg, #3d3531 0%, #594d47 40%, #70625a 75%, #4a3e38 100%)',
  charcoal: 'linear-gradient(180deg, #1c1e21 0%, #30343a 40%, #444951 75%, #23272c 100%)',
  plum: 'linear-gradient(180deg, #2d262e 0%, #473c49 40%, #5e5160 75%, #3d323f 100%)',
};

const backgroundStyle = customBackground || gradients[theme] || gradients.sage;
---

<header class="hero" id="hero" style={`background: ${backgroundStyle};`}>
  <!-- Center Typographic Group -->
  <div class="hero-center">
    <h1 class="hero-title">
      <span class="title-line">{titleLine1}</span>
      <span class="title-line">{titleLine2}</span>
    </h1>
    <p class="hero-subtitle">{subtitle}</p>
  </div>

  <!-- Bottom Meta & Navigation Row -->
  <div class="hero-bottom">
    <div class="meta-left">
      <span class="meta-label">Last updated</span>
      <span class="meta-value">{lastUpdated}</span>
    </div>

    <nav class="nav-capsule" aria-label="Main navigation">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class:list={['nav-item', { active: item.active }]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="meta-right">
      <span>{location}</span>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: clamp(2rem, 5vh, 3.5rem) clamp(1.25rem, 4vw, 3rem) clamp(1.75rem, 4vh, 2.5rem);
    box-sizing: border-box;
    color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', Roboto, sans-serif;
    user-select: none;
    overflow: hidden;
  }

  /* Center Typographic Stack */
  .hero-center {
    margin: auto 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 960px;
    width: 100%;
    padding: 1rem 0;
  }

  .hero-title {
    margin: 0;
    font-size: clamp(2.5rem, 11vw, 8.5rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    word-break: break-word;
  }

  .title-line {
    display: block;
  }

  .hero-subtitle {
    margin-top: clamp(1rem, 3vh, 1.75rem);
    max-width: 480px;
    font-size: clamp(0.6rem, 1.8vw, 0.68rem);
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    padding: 0 0.5rem;
  }

  /* Bottom Row */
  .hero-bottom {
    width: 100%;
    max-width: 1360px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.85);
  }

  .meta-left {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.72rem;
  }

  .meta-label {
    color: rgba(255, 255, 255, 0.6);
  }

  .meta-value {
    color: rgba(255, 255, 255, 0.95);
  }

  .meta-right {
    display: flex;
    justify-content: flex-end;
    color: rgba(255, 255, 255, 0.85);
    font-variant-numeric: tabular-nums;
    font-size: 0.72rem;
  }

  /* Navigation Pill */
  .nav-capsule {
    display: inline-flex;
    align-items: center;
    padding: 3px;
    border-radius: 9999px;
    background-color: rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .nav-capsule::-webkit-scrollbar {
    display: none;
  }

  .nav-item {
    padding: 0.38rem 0.95rem;
    border-radius: 9999px;
    font-size: 0.72rem;
    font-weight: 500;
    color: #ffffff;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .nav-item:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.15);
  }

  .nav-item.active {
    background-color: #121516;
    color: #ffffff;
  }

  @media (max-width: 900px) {
    .hero-bottom {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }

    .meta-left, .meta-right {
      justify-content: center;
    }

    .nav-capsule {
      order: -1;
      width: fit-content;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding: 1.5rem 1rem 1.5rem;
    }

    .hero-title {
      font-size: clamp(2.2rem, 13vw, 3.6rem);
      line-height: 0.95;
    }

    .hero-subtitle {
      max-width: 300px;
      font-size: 0.58rem;
    }

    .nav-item {
      padding: 0.32rem 0.75rem;
      font-size: 0.68rem;
    }
  }
</style>
