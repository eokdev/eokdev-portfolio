---
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  name?: string;
  role?: string;
  description?: string;
  navLinks?: NavLink[];
}

const {
  name = "Emmanuel Olorunshola",
  role = "Flutter Engineer",
  description = "If it belongs on a phone, I will build it.",
  navLinks = [
    { label: "Work", href: "#work" },
    { label: "Experience", href: "#experience" },
    { label: "About", href: "#about" },
    { label: "Contact", href: "#contact" },
  ],
} = Astro.props;
---

<header class="hero-section" id="hero">
  <!-- Top White Editorial Area -->
  <div class="hero-canvas">
    <!-- Top Editorial Header Bar -->
    <div class="hero-topbar" data-hero-topbar>
      <a href="#hero" class="brand-name">
        <img src="/images/logo-dark.svg" alt="EOK Logo" class="brand-logo" />
        <span>{name}</span>
      </a>
      <nav class="top-nav" aria-label="Quick links">
        {
          navLinks.map((link, idx) => (
            <span class="nav-entry">
              <a href={link.href} class="nav-text-link">
                {link.label}
              </a>
              {idx < navLinks.length - 1 && <span class="nav-comma">, </span>}
            </span>
          ))
        }
      </nav>
    </div>

    <div class="hero-body">
      <div class="headline-col" data-hero-headline>
        <h1 class="display-title">
          <span class="title-line name-line">{name}</span>
          <span class="title-line role-line">{role}</span>
        </h1>
        <p class="display-description">
          {description}
        </p>
      </div>
    </div>
  </div>
</header>

<script>
  import gsap from "gsap";

  function initHeroAnimation() {
    const hero = document.querySelector<HTMLElement>(".hero-section");
    if (!hero || hero.dataset.heroReady === "1") return;
    hero.dataset.heroReady = "1";

    const topbar = document.querySelector<HTMLElement>("[data-hero-topbar]");
    const titleLines = document.querySelectorAll<HTMLElement>(
      "[data-hero-headline] .title-line",
    );
    const description = document.querySelector<HTMLElement>(
      "[data-hero-headline] .display-description",
    );
    if (!titleLines.length) return;

    const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

    if (topbar) {
      tl.fromTo(
        topbar,
        { opacity: 0, y: -15 },
        { opacity: 1, y: 0, duration: 0.8, clearProps: "transform" },
      );
    }

    // Title entrance
    tl.fromTo(
      titleLines,
      { opacity: 0, y: 40 },
      {
        opacity: 1,
        y: 0,
        duration: 1.0,
        stagger: 0.12,
        clearProps: "transform",
      },
      "-=0.5",
    );

    // Description entrance
    if (description) {
      tl.fromTo(
        description,
        { y: 16 },
        { y: 0, duration: 0.7, clearProps: "transform" },
        "-=0.6",
      );
    }

  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeroAnimation);
  } else {
    initHeroAnimation();
  }
  document.addEventListener("astro:page-load", initHeroAnimation);
</script>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    min-width: 100%;
    background-color: #ffffff;
    color: #111111;
    font-family:
      -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, sans-serif;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Upper Canvas Area */
  .hero-canvas {
    width: 100%;
    max-width: 100%;
    padding: clamp(1.5rem, 3vw, 2.75rem) clamp(1.25rem, 4vw, 3.5rem) clamp(2rem, 4.5vw, 3.75rem);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    min-height: auto;
    justify-content: space-between;
  }

  /* Top Bar */
  .hero-topbar {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: clamp(0.8rem, 1vw, 0.92rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #111111;
    flex-wrap: wrap;
  }

  .brand-name {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: #111111;
    text-decoration: none;
    font-weight: 600;
    transition: opacity 0.2s ease;
    flex-shrink: 0;
  }

  .brand-logo {
    width: 20px;
    height: 20px;
    display: block;
  }

  .brand-name:hover {
    opacity: 0.7;
  }

  .top-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    font-weight: 400;
    color: #222222;
    gap: 0.15rem 0.35rem;
  }

  .nav-entry {
    display: inline-flex;
    align-items: center;
  }

  .nav-text-link {
    color: #222222;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-text-link:hover {
    color: #000000;
    text-decoration: underline;
  }

  .nav-comma {
    margin-right: 0.2rem;
    color: #888888;
  }

  .hero-body {
    width: 100%;
    display: flex;
    justify-content: flex-start;
    margin-top: clamp(2.5rem, 6vh, 5rem);
  }

  .headline-col {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vh, 1.75rem);
    width: min(720px, 100%);
  }

  .display-title {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .title-line {
    display: block;
  }

  .name-line {
    font-size: clamp(2.1rem, 4.4vw, 4.4rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.035em;
    color: #111111;
  }

  .role-line {
    font-size: clamp(1.05rem, 1.9vw, 1.5rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: #555555;
  }

  .display-description {
    margin: 0;
    max-width: 540px;
    font-size: clamp(0.85rem, 1.05vw, 0.98rem);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: #333333;
  }

  /* Responsive Breakpoints */
  @media (max-width: 960px) {
    .hero-canvas {
      padding: clamp(1.25rem, 3vw, 2rem) clamp(1rem, 3vw, 2rem) clamp(1.75rem, 4vw, 2.5rem);
    }

    .hero-body {
      justify-content: flex-start;
      margin-top: clamp(2rem, 4vh, 3.5rem);
    }

    .name-line {
      font-size: clamp(2.2rem, 6.5vw, 3.6rem);
    }
  }

  @media (max-width: 600px) {
    .hero-topbar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem;
    }

    .brand-name {
      font-size: 0.88rem;
    }

    .brand-logo {
      width: 18px;
      height: 18px;
    }

    .top-nav {
      font-size: 0.8rem;
    }

    .hero-body {
      gap: 1.5rem;
      margin-top: 2rem;
    }

    .name-line {
      font-size: clamp(1.85rem, 8.2vw, 2.5rem);
      line-height: 1.1;
    }

    .role-line {
      font-size: 1.05rem;
    }

    .display-description {
      font-size: 0.86rem;
      line-height: 1.5;
    }
  }

  @media (max-width: 380px) {
    .hero-topbar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
