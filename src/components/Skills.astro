---
const capabilities = [
  {
    title: 'Core',
    detail: 'Dart, Flutter, Android, iOS, Clean Architecture, MVVM, MVC.',
  },
  {
    title: 'State & Data',
    detail: 'Riverpod, Provider, BLoC, REST, GraphQL, SQLite, Hive, Shared Preferences.',
  },
  {
    title: 'Platform',
    detail: 'Firebase Auth, Firestore, FCM, WebSockets, Deep linking, Google Maps, Geofencing, Bluetooth printing.',
  },
  {
    title: 'Product',
    detail: 'Paystack, Stripe, Apple Pay, Google Pay, In app purchases, GoCardless, CI/CD, Git, Testing.',
  },
];
---

<section class="capabilities-section" id="capabilities">
  <div class="capabilities-wrapper">
    <!-- Centered Editorial Headline -->
    <div class="capabilities-header">
      <span class="section-label">CAPABILITIES</span>
      <h2 class="section-title">Built for Performance & Scale</h2>
      <p class="section-subtitle">
        Engineering reliable cross platform systems for phones, field operations, and real users.
      </p>
    </div>

    <!-- Minimalist 4-Item Row with Expansive Whitespace -->
    <div class="capabilities-row">
      {capabilities.map((item) => (
        <div class="capability-node">
          <h3 class="node-title">{item.title}</h3>
          <p class="node-detail">{item.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .capabilities-section {
    position: relative;
    width: 100%;
    padding: clamp(7rem, 13vh, 13rem) clamp(1.25rem, 4vw, 3.5rem) clamp(8rem, 14vh, 14rem);
    box-sizing: border-box;
    background-color: #ffffff;
    color: #141414;
    font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', Roboto, sans-serif;
    user-select: none;
  }

  .capabilities-wrapper {
    position: relative;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(4.5rem, 9vh, 7.5rem);
  }

  /* Centered Header */
  .capabilities-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    max-width: 760px;
  }

  .section-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8c8c8c;
  }

  .section-title {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #121212;
  }

  .section-subtitle {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
    color: #666666;
    max-width: 540px;
  }

  /* 4-Item Minimalist Row */
  .capabilities-row {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3.5rem;
    align-items: start;
  }

  .capability-node {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .node-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #171717;
    line-height: 1.3;
  }

  .node-detail {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.6;
    color: #737373;
  }

  @media (max-width: 1024px) {
    .capabilities-row {
      grid-template-columns: repeat(2, 1fr);
      gap: 3.5rem 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .capabilities-row {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .section-title {
      font-size: 2rem;
    }

    .section-subtitle {
      font-size: 0.95rem;
    }
  }
</style>
